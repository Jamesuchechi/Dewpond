{
  "name": "dewpond",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dewpond/web dev",
    "build": "pnpm --filter @dewpond/web build",
    "preview": "pnpm --filter @dewpond/web preview",
    "fetch:duckdb": "node scripts/fetch-duckdb.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/test-m0-e2e.mjs",
    "test:m1": "node scripts/test-m1-dod.mjs",
    "test:m2": "node scripts/test-m2-dod.mjs",
    "test:m3": "node scripts/test-m3-dod.mjs",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.15.0",
    "fast-check": "^4.10.3",
    "globals": "17.14.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
