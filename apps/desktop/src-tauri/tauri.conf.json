{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dewpond",
  "version": "1.0.0",
  "identifier": "app.dewpond.workbench",
  "build": {
    "beforeDevCommand": "pnpm --filter @dewpond/web dev",
    "devUrl": "http://127.0.0.1:5173/app/",
    "beforeBuildCommand": "pnpm --filter @dewpond/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Dewpond — Local Data Workbench",
        "url": "app/index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first, zero-upload data workbench powered by DuckDB-WASM",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
